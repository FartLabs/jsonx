{
  "lock": false,
  "name": "@fartlabs/jsonx",
  "version": "0.0.11",
  "exports": {
    "./jsx-runtime": "./lib/std/runtime/mod.ts",
    "./std/arithmetic": "./lib/std/arithmetic/mod.ts",
    "./std/assets": "./lib/std/assets/mod.ts",
    "./std/assets/local": "./lib/std/assets/local/mod.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@fartlabs/jsonx"
  },
  "imports": {
    "jsonx/": "./lib/",
    "@cross/deepmerge": "jsr:@cross/deepmerge@^1.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.15",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/fs": "jsr:@std/fs@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.2",
    "@std/yaml": "jsr:@std/yaml@^1.0.10"
  },
  "tasks": {
    "test": "deno test -A",
    "generate": {
      "description": "Generate code",
      "dependencies": [
        "generate:workflow:check",
        "generate:workflow:publish"
      ]
    },
    "generate:workflow:check": "deno --allow-write .github/workflows/check.tsx .github/workflows/check.yaml",
    "generate:workflow:publish": "deno --allow-write .github/workflows/publish.tsx .github/workflows/publish.yaml"
  }
}
